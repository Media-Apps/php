ARG DHI_BUILDER_IMAGE=dhi.io/debian-base:trixie-dev
ARG DHI_RUNTIME_IMAGE=dhi.io/debian-base:trixie
ARG TARGETOS=linux
ARG TARGETARCH
ARG TARGETVARIANT

FROM ${DHI_BUILDER_IMAGE} AS builder

ARG PHP_VERSION=7.4.33
ARG PHP_PREFIX=/opt/php-7.4

ENV DEBIAN_FRONTEND=noninteractive
ENV PHP_PREFIX=${PHP_PREFIX}
ENV PHP_INI_DIR=${PHP_PREFIX}/etc/php

RUN set -eux; \
  apt-get update; \
  apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    autoconf \
    automake \
    bison \
    build-essential \
    init-system-helpers \
    pkg-config \
    re2c \
    libxml2-dev \
    libsqlite3-dev \
    libcurl4-openssl-dev \
    libonig-dev \
    libzip-dev \
    zlib1g-dev \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libwebp-dev \
    libicu-dev \
    libgmp-dev \
    libmagickwand-dev \
    libldap2-dev \
    libpq-dev \
    libkrb5-dev \
    libsasl2-dev \
    libssl-dev \
    libreadline-dev \
    locales \
    libsmbclient-dev; \
  rm -rf /var/lib/apt/lists/*

RUN set -eux; \
  printf '%s\n' \
    'en_US.UTF-8 UTF-8' \
    'fr_FR.UTF-8 UTF-8' \
    'es_ES.UTF-8 UTF-8' \
    'de_DE.UTF-8 UTF-8' \
    'ru_RU.UTF-8 UTF-8' \
    'pt_BR.UTF-8 UTF-8' \
    'it_IT.UTF-8 UTF-8' \
    'ja_JP.UTF-8 UTF-8' \
    'zh_CN.UTF-8 UTF-8' \
    > /etc/locale.gen; \
  locale-gen

RUN set -eux; \
  curl -fsSL "https://www.php.net/distributions/php-${PHP_VERSION}.tar.xz" -o /tmp/php.tar.xz; \
  mkdir -p /usr/src/php; \
  tar -xf /tmp/php.tar.xz -C /usr/src/php --strip-components=1; \
  rm -f /tmp/php.tar.xz

RUN set -eux; \
  cd /usr/src/php; \
  export CXXFLAGS="-std=gnu++17"; \
  ./buildconf --force; \
  ./configure \
    --prefix="${PHP_PREFIX}" \
    --with-config-file-path="${PHP_INI_DIR}" \
    --with-config-file-scan-dir="${PHP_INI_DIR}/conf.d" \
    --enable-fpm \
    --with-fpm-user=www-data \
    --with-fpm-group=www-data \
    --enable-mbstring \
    --enable-intl \
    --enable-soap \
    --enable-bcmath \
    --enable-pcntl \
    --enable-opcache \
    --with-zlib \
    --with-curl \
    --with-readline \
    --with-zip \
    --with-gmp \
    --with-kerberos \
    --with-ldap \
    --with-ldap-sasl \
    --with-pgsql \
    --with-pdo-pgsql \
    --with-mysqli=mysqlnd \
    --with-pdo-mysql=mysqlnd \
    --with-sqlite3 \
    --with-pdo-sqlite \
    --enable-gd \
    --with-freetype \
    --with-jpeg \
    --with-webp; \
  make -j"$(nproc)"; \
  make install

RUN set -eux; \
  mkdir -p "${PHP_INI_DIR}/conf.d" "${PHP_PREFIX}/etc/php-fpm.d"; \
  cp /usr/src/php/php.ini-production "${PHP_INI_DIR}/php.ini"; \
  cp /usr/src/php/sapi/fpm/php-fpm.conf "${PHP_PREFIX}/etc/php-fpm.conf"; \
  cp /usr/src/php/sapi/fpm/www.conf "${PHP_PREFIX}/etc/php-fpm.d/www.conf"; \
  mkdir -p "${PHP_PREFIX}/var/log"; \
  touch "${PHP_PREFIX}/var/log/php-fpm.log"; \
  chown -R 33:33 "${PHP_PREFIX}/var"; \
  sed -ri 's!^;?daemonize =.*!daemonize = no!' "${PHP_PREFIX}/etc/php-fpm.conf"; \
  sed -ri 's!^listen = .*!listen = 9000!' "${PHP_PREFIX}/etc/php-fpm.d/www.conf"; \
  sed -ri 's!^;?clear_env =.*!clear_env = no!' "${PHP_PREFIX}/etc/php-fpm.d/www.conf"

RUN set -eux; \
  export PATH="${PHP_PREFIX}/bin:${PATH}"; \
  curl -fsSL "https://pecl.php.net/get/apcu-5.1.22.tgz" -o /tmp/apcu.tgz; \
  mkdir -p /usr/src/apcu; \
  tar -xzf /tmp/apcu.tgz -C /usr/src/apcu --strip-components=1; \
  cd /usr/src/apcu; \
  phpize; \
  ./configure --with-php-config="${PHP_PREFIX}/bin/php-config"; \
  make -j"$(nproc)"; \
  make install; \
  curl -fsSL "https://pecl.php.net/get/redis-6.2.0.tgz" -o /tmp/redis.tgz; \
  mkdir -p /usr/src/redis; \
  tar -xzf /tmp/redis.tgz -C /usr/src/redis --strip-components=1; \
  cd /usr/src/redis; \
  phpize; \
  ./configure --with-php-config="${PHP_PREFIX}/bin/php-config"; \
  make -j"$(nproc)"; \
  make install; \
  curl -fsSL "https://pecl.php.net/get/smbclient-1.1.2.tgz" -o /tmp/smbclient.tgz; \
  mkdir -p /usr/src/smbclient; \
  tar -xzf /tmp/smbclient.tgz -C /usr/src/smbclient --strip-components=1; \
  cd /usr/src/smbclient; \
  phpize; \
  ./configure --with-php-config="${PHP_PREFIX}/bin/php-config"; \
  make -j"$(nproc)"; \
  make install; \
  curl -fsSL "https://pecl.php.net/get/imagick-3.7.0.tgz" -o /tmp/imagick.tgz; \
  mkdir -p /usr/src/imagick; \
  tar -xzf /tmp/imagick.tgz -C /usr/src/imagick --strip-components=1; \
  cd /usr/src/imagick; \
  phpize; \
  ./configure --with-php-config="${PHP_PREFIX}/bin/php-config"; \
  make -j"$(nproc)"; \
  make install; \
  printf '%s\n' \
    'extension=apcu.so' \
    'extension=redis.so' \
    'extension=smbclient.so' \
    'extension=imagick.so' \
    > "${PHP_INI_DIR}/conf.d/50-extra.ini"; \
  "${PHP_PREFIX}/sbin/php-fpm" -t; \
  rm -rf /tmp/apcu.tgz /tmp/redis.tgz /tmp/smbclient.tgz /tmp/imagick.tgz /usr/src/apcu /usr/src/redis /usr/src/smbclient /usr/src/imagick

ENV GOMPLATE_VERSION="v4.3.1" \
    WAIT_FOR_VERSION="v2.0.9" \
    RETRY_VERSION="v2.0.0"

RUN set -eux; \
  apt-get update; \
  apt-get install -y --no-install-recommends \
    apache2 \
    cron \
    ca-certificates \
    bash \
    curl \
    wget \
    procps \
    apt-utils \
    apt-transport-https \
    bzip2 \
    jq \
    gnupg \
    libnss-wrapper; \
  a2enmod proxy proxy_fcgi setenvif rewrite headers env dir mime expires remoteip; \
  sed -ri 's!^export APACHE_RUN_DIR=.*!export APACHE_RUN_DIR=/tmp/apache2/run!' /etc/apache2/envvars; \
  sed -ri 's!^export APACHE_LOCK_DIR=.*!export APACHE_LOCK_DIR=/tmp/apache2/lock!' /etc/apache2/envvars; \
  sed -ri 's!^export APACHE_LOG_DIR=.*!export APACHE_LOG_DIR=/tmp/apache2/log!' /etc/apache2/envvars; \
  sed -ri 's!^export APACHE_PID_FILE=.*!export APACHE_PID_FILE=/tmp/apache2/run/apache2.pid!' /etc/apache2/envvars; \
  mkdir -p /tmp/apache2/run /tmp/apache2/lock /tmp/apache2/log; \
  chown -R 33:33 /tmp/apache2; \
  mkdir -p /etc/apache2/sites-enabled "${PHP_INI_DIR}/conf.d"; \
  rm -f /etc/apache2/sites-enabled/000-default.conf; \
  touch /etc/apache2/sites-enabled/default.conf /etc/apache2/sites-enabled/000-default.conf "${PHP_INI_DIR}/conf.d/90-owncloud.ini" "${PHP_INI_DIR}/conf.d/91-owncloud-web.ini"; \
  chgrp root /etc/apache2/sites-enabled/default.conf /etc/apache2/sites-enabled/000-default.conf "${PHP_INI_DIR}/conf.d/90-owncloud.ini" "${PHP_INI_DIR}/conf.d/91-owncloud-web.ini"; \
  chmod g+w /etc/apache2/sites-enabled/default.conf /etc/apache2/sites-enabled/000-default.conf "${PHP_INI_DIR}/conf.d/90-owncloud.ini" "${PHP_INI_DIR}/conf.d/91-owncloud-web.ini"; \
  rm -rf /var/lib/apt/lists/*

RUN set -eux; \
  target_os="${TARGETOS:-linux}"; \
  arch="$(uname -m)"; \
  case "${TARGETARCH:-}" in \
    amd64|arm64) target_arch="${TARGETARCH}" ;; \
    *) case "$arch" in \
      x86_64) target_arch="amd64" ;; \
      aarch64) target_arch="arm64" ;; \
      *) echo "unsupported architecture: $arch"; exit 1 ;; \
    esac ;; \
  esac; \
  target_variant="${TARGETVARIANT:-}"; \
  mkdir -p /usr/local/bin; \
  curl -fsSL "https://github.com/hairyhenderson/gomplate/releases/download/${GOMPLATE_VERSION}/gomplate_${target_os}-${target_arch}${target_variant}" -o /usr/local/bin/gomplate; \
  curl -fsSL "https://github.com/owncloud-ci/wait-for/releases/download/${WAIT_FOR_VERSION}/wait-for-${target_os}-${target_arch}${target_variant}" -o /usr/bin/wait-for; \
  curl -fsSL "https://github.com/owncloud-ci/retry/releases/download/${RETRY_VERSION}/retry" -o /usr/bin/retry; \
  chmod +x /usr/local/bin/gomplate /usr/bin/wait-for /usr/bin/retry

# Minimal runtime executables (avoid copying full /usr/bin and /usr/sbin from the builder, which includes apt/dpkg).
RUN set -eux; \
  dest=/opt/runtime-paths; \
  rm -rf "$dest"; \
  mkdir -p "$dest"; \
  copy_to() { \
    src="$1"; \
    rel="$2"; \
    if [ ! -e "$src" ]; then echo "runtime-paths: missing $src" >&2; exit 1; fi; \
    mkdir -p "$dest/$(dirname "$rel")"; \
    cp -a "$src" "$dest/$rel"; \
  }; \
  copy_to /bin/bash usr/bin/bash; \
  copy_to /bin/sh usr/bin/sh; \
  for f in \
    env \
    curl \
    sed \
    find \
    sort \
    xargs \
    grep \
    getent \
    id \
    tr \
    cut \
    basename \
    setpriv \
    mawk \
    awk \
    stat \
    mktemp \
    readlink \
    chmod \
    chown \
    mkdir \
    rm \
    ln \
    mv \
    cat \
    ls \
    cp \
    sleep \
    date \
    uname \
    touch \
    rmdir \
    head \
    tail \
    wc \
    wait-for \
    retry \
  ; do \
    copy_to "/usr/bin/$f" "usr/bin/$f"; \
  done; \
  for f in apache2 apache2ctl apachectl cron; do \
    copy_to "/usr/sbin/$f" "usr/sbin/$f"; \
  done; \
  copy_to /usr/local/bin/gomplate usr/local/bin/gomplate; \
  mkdir -p "$dest/etc/pam.d" "$dest/etc/default" "$dest/etc/ssl/certs"; \
  cp -a /etc/pam.d/cron "$dest/etc/pam.d/cron"; \
  cp -a /etc/default/cron "$dest/etc/default/cron"; \
  test -f /etc/ssl/certs/ca-certificates.crt; \
  cp -a /etc/ssl/certs/ca-certificates.crt "$dest/etc/ssl/certs/ca-certificates.crt"; \
  mkdir -p "$dest/usr/lib"; \
  ln -sf /usr/lib/x86_64-linux-gnu/libnss_wrapper.so "$dest/usr/lib/libnss_wrapper.so"

FROM ${DHI_RUNTIME_IMAGE}

ARG PHP_PREFIX=/opt/php-7.4

ENV PHP_PREFIX=${PHP_PREFIX}
ENV PHP_INI_DIR=${PHP_PREFIX}/etc/php
ENV PATH=${PHP_PREFIX}/bin:${PHP_PREFIX}/sbin:${PATH}

COPY --from=builder ${PHP_PREFIX} ${PHP_PREFIX}
COPY --from=builder /usr/lib/x86_64-linux-gnu /usr/lib/x86_64-linux-gnu
COPY --from=builder /usr/lib/apache2 /usr/lib/apache2
COPY --from=builder /usr/lib/locale /usr/lib/locale
COPY --from=builder /lib/x86_64-linux-gnu /lib/x86_64-linux-gnu
COPY --from=builder /etc/apache2 /etc/apache2
COPY --from=builder /opt/runtime-paths/ /
COPY --from=builder /var/lib/apache2 /var/lib/apache2
COPY --from=builder /var/log/apache2 /var/log/apache2
COPY --from=builder /var/spool/cron /var/spool/cron
COPY --from=builder /etc/passwd /etc/passwd
COPY --from=builder /etc/group /etc/group
COPY --from=builder /etc/mime.types /etc/mime.types
# OwnCloud entrypoint writes Apache/PHP rendered configs here at runtime.
COPY --from=builder --chown=www-data:www-data /etc/apache2/sites-enabled /etc/apache2/sites-enabled
COPY --from=builder --chown=www-data:www-data ${PHP_PREFIX}/etc/php/conf.d ${PHP_PREFIX}/etc/php/conf.d

ADD overlay /

EXPOSE 8080

USER www-data
WORKDIR /var/www/html

ENTRYPOINT ["/bin/bash", "/usr/bin/entrypoint"]
CMD ["/bin/bash", "/usr/bin/server"]
